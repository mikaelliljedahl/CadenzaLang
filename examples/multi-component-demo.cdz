// Multi-Component Navigation Demo
// Simple components to test the navigation system

component Counter() -> UIComponent {
    declare_state count: int = 0
    
    event_handler handle_increment() uses [DOM] {
        set_state(count, count + 1)
    }
    
    event_handler handle_decrement() uses [DOM] {
        set_state(count, count - 1)
    }
    
    render {
        container(
            class: "semantic: padding:lg, flex-column, center",
            style: "semantic: background:background-alt"
        ) {
            heading(
                level: 1, 
                text: "Counter Component",
                class: "semantic: text:primary, margin:md"
            )
            heading(
                level: 2, 
                text: "Count: " + count.toString(),
                class: "semantic: text:secondary, margin:md"
            )
            container(
                class: "semantic: flex, gap:md"
            ) {
                button(
                    text: "Increment",
                    on_click: handle_increment,
                    class: "btn-primary"
                )
                button(
                    text: "Decrement", 
                    on_click: handle_decrement,
                    class: "btn-secondary"
                )
            }
        }
    }
}

component Greeting() -> UIComponent {
    declare_state name: string = "World"
    declare_state message: string = "Hello"
    
    event_handler handle_name_change() uses [DOM] {
        set_state(name, "Claude")
    }
    
    event_handler handle_message_change() uses [DOM] {
        set_state(message, "Greetings")
    }
    
    render {
        container(
            class: "semantic: padding:lg, flex-column, center",
            style: "semantic: background:success-light"
        ) {
            heading(
                level: 1, 
                text: "Greeting Component",
                class: "semantic: text:success, margin:md"
            )
            heading(
                level: 2, 
                text: message + ", " + name + "!",
                class: "semantic: text:dark, margin:md"
            )
            container(
                class: "semantic: flex, gap:md"
            ) {
                button(
                    text: "Change Name",
                    on_click: handle_name_change,
                    class: "btn-secondary"
                )
                button(
                    text: "Change Message",
                    on_click: handle_message_change,
                    class: "btn-secondary"
                )
            }
        }
    }
}

component ColorPicker() -> UIComponent {
    declare_state selected_color: string = "red"
    
    event_handler handle_red_select() uses [DOM] {
        set_state(selected_color, "red")
    }
    
    event_handler handle_green_select() uses [DOM] {
        set_state(selected_color, "green")
    }
    
    event_handler handle_blue_select() uses [DOM] {
        set_state(selected_color, "blue")
    }
    
    event_handler handle_purple_select() uses [DOM] {
        set_state(selected_color, "purple")
    }
    
    event_handler handle_orange_select() uses [DOM] {
        set_state(selected_color, "orange")
    }
    
    render {
        container(
            class: "semantic: padding:lg, flex-column, center",
            style: "semantic: background:" + selected_color + "-light"
        ) {
            heading(
                level: 1, 
                text: "Color Picker Component",
                class: "semantic: text:" + selected_color + ", margin:md"
            )
            heading(
                level: 3, 
                text: "Selected: " + selected_color,
                class: "semantic: text:dark, margin:md"
            )
            container(
                class: "semantic: flex, gap:sm, flex-wrap"
            ) {
                button(
                    text: "red",
                    on_click: handle_red_select,
                    class: "btn-red"
                )
                button(
                    text: "green",
                    on_click: handle_green_select,
                    class: "btn-green"
                )
                button(
                    text: "blue",
                    on_click: handle_blue_select,
                    class: "btn-blue"
                )
                button(
                    text: "purple",
                    on_click: handle_purple_select,
                    class: "btn-purple"
                )
                button(
                    text: "orange",
                    on_click: handle_orange_select,
                    class: "btn-orange"
                )
            }
        }
    }
}