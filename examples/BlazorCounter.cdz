component BlazorCounter() -> UIComponent {
    declare_state currentCount: int = 0
    
    event_handler handle_increment() uses [DOM] {
        set_state(currentCount, currentCount + 1)
    }
    
    render {
        container(
            class: "semantic: padding:lg, flex-column, center",
            style: "semantic: background:background-alt"
        ) {
            heading(
                level: 1, 
                text: "Counter: " + currentCount.toString(),
                class: "semantic: text:primary, margin:md"
            )
            container(
                class: "semantic: flex, gap:md"
            ) {
                button(
                    text: "Click me",
                    on_click: handle_increment,
                    class: "btn-primary"
                )
            }
            container(
                class: "semantic: margin:md, text:center"
            ) {
                heading(
                    level: 3,
                    text: "Status: OK",
                    class: "text-muted"
                )
            }
        }
    }
}